{
  "name": "tim.codes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "build-only": "vite build",
    "type-check": "pnpm type-check:native && vue-tsc --build",
    "lint:oxlint": "oxlint -c oxlintrc.json src",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,scss,sass}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{vue,css,scss,sass}\" --fix",
    "lint:knip": "knip",
    "lint": "run-s lint:oxlint 'lint:eslint' 'lint:stylelint' 'lint:knip'",
    "lint:fix": "run-s lint:oxlint 'lint:eslint:fix' 'lint:stylelint:fix' 'lint:knip'",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "doc": "typedoc --out docs src --skipErrorChecking",
    "type-check:native": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@sentry/vue": "^11.10.0",
    "@vueuse/core": "^15.0.0",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/setimmediate": "^1.0.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "setimmediate": "^1.0.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "terser": "^5.51.2",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.16.1"
}

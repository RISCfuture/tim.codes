{
  "name": "tim.codes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint -c oxlintrc.json src",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,scss,sass}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{vue,css,scss,sass}\" --fix",
    "lint:knip": "knip",
    "lint": "run-s lint:oxlint 'lint:eslint' 'lint:stylelint' 'lint:knip'",
    "lint:fix": "run-s lint:oxlint 'lint:eslint:fix' 'lint:stylelint:fix' 'lint:knip'",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "doc": "npx typedoc --out docs src"
  },
  "dependencies": {
    "@sentry/vue": "^10.70.0",
    "@vueuse/core": "^14.4.0",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@types/setimmediate": "^1.0.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/server-renderer": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "setimmediate": "^1.0.5",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "terser": "^5.50.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.22.0"
}

{
  "entry": ["src/**/__tests__/**/*.spec.ts"],
  "project": ["src/**/*.{ts,vue}"],
  "ignore": ["src/i18n/strings/*/private.deploy.ts", "src/i18n/strings/types.ts"],
  "ignoreDependencies": [
    "@types/setimmediate",
    "@vue/compiler-dom",
    "@vue/server-renderer",
    "@vue/test-utils",
    "setimmediate",
    "stylelint-config-recommended-scss"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "error",
    "enumMembers": "off",
    "unresolved": "off"
  }
}
